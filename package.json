{
  "name": "sistema-gestao-financeira",
  "version": "1.0.0",
  "private": true,
  "description": "Sistema profissional de gestão e simulação de investimentos",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:api": "npm run start:dev --workspace=apps/api",
